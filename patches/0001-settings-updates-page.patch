+import Switch from '@mui/material/Switch';
+import Typography from '@mui/material/Typography';
+import { useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import NameValueTable from '../../common/NameValueTable';
+import SectionBox from '../../common/SectionBox';
+
+// ReleaseNotes reads this at startup to skip the update check, and the update
+// notice's bell button sets it.
+const DISABLE_UPDATE_CHECK = 'disable_update_check';
+
+/** Settings for the update check the desktop app runs when it starts. */
+export default function UpdateSettings() {
+  const { t } = useTranslation(['translation']);
+  const [checkForUpdates, setCheckForUpdates] = useState<boolean>(
+    () => !JSON.parse(localStorage.getItem(DISABLE_UPDATE_CHECK) || 'false')
+  );
+  const checkLabelID = 'check-for-updates-label';
+
+  function handleCheckForUpdatesChange(enabled: boolean) {
+    localStorage.setItem(DISABLE_UPDATE_CHECK, JSON.stringify(!enabled));
+    setCheckForUpdates(enabled);
+  }
+
+  return (
+    <SectionBox title={t('translation|Updates')} backLink>
+      <NameValueTable
+        rows={[
+          {
+            name: t('translation|Check for updates at startup'),
+            value: (
+              <Switch
+                color="primary"
+                checked={checkForUpdates}
+                onChange={e => handleCheckForUpdatesChange(e.target.checked)}
+                inputProps={{
+                  'aria-labelledby': checkLabelID,
+                }}
+              />
+            ),
+            nameID: checkLabelID,
+          },
+        ]}
+      />
+      <Typography variant="body2" color="text.secondary" sx={{ mt: 2 }}>
+        {t(
+          'translation|When a newer release is out, a notice links to it. Changes apply the next time the app starts.'
+        )}
+      </Typography>
+    </SectionBox>
+  );
+}
