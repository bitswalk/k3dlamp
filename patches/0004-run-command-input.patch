+/** The most a capability command may receive on standard input: 1 MiB of UTF-16 code units. */
+const MAX_CAPABILITY_INPUT_LENGTH = 1024 * 1024;
+
+/**
+ * Whether options sent with a command capability are allowed: none, or only
+ * `input`, a string for the command's standard input.
+ */
+function isCapabilityCommandOptions(options: object): boolean {
+  if (Object.getPrototypeOf(options) !== Object.prototype) {
+    return false;
+  }
+  const keys = Reflect.ownKeys(options);
+  if (keys.length === 0) {
+    return true;
+  }
+  const { input } = options as { input?: unknown };
+  return (
+    keys.length === 1 &&
+    keys[0] === 'input' &&
+    typeof input === 'string' &&
+    input.length <= MAX_CAPABILITY_INPUT_LENGTH
+  );
+}
