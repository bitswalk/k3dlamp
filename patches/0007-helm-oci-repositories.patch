+// An OCI repository has no index, which must not stop the other repositories'
+// charts from being listed.
+func TestListChartsSkipsOCIRepositories(t *testing.T) {
+	settings := newOCITestSettings(t)
+	repoFile := repo.NewFile()
+	repoFile.Update(
+		&repo.Entry{Name: "kubevirt", URL: "oci://ghcr.io/naval-group/kubevirt-stack-charts/kubevirt"},
+		&repo.Entry{Name: "cnpg", URL: "https://cloudnative-pg.github.io/charts"},
+	)
+	require.NoError(t, repoFile.WriteFile(settings.RepositoryConfig, defaultNewConfigFileMode))
+
+	index := repo.NewIndexFile()
+	require.NoError(t, index.MustAdd(&chart.Metadata{
+		APIVersion: chart.APIVersionV2, Name: "cloudnative-pg", Version: "0.29.1",
+	}, "cloudnative-pg-0.29.1.tgz", "https://cloudnative-pg.github.io/charts", "sha256:0"))
+	require.NoError(t, os.MkdirAll(settings.RepositoryCache, defaultNewConfigFolderMode))
+	require.NoError(t, index.WriteFile(
+		filepath.Join(settings.RepositoryCache, helmpath.CacheIndexFile("cnpg")), defaultNewConfigFileMode))
+
+	charts, err := listCharts("", settings)
+	require.NoError(t, err)
+	require.Len(t, charts, 1)
+	assert.Equal(t, "cnpg/cloudnative-pg", charts[0].Name)
+}
