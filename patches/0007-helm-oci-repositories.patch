+// ociRepoChart returns the oci:// reference of a <repo>/<chart> name whose
+// repository is an OCI registry, and false for any other name. Helm looks
+// <repo>/<chart> up in the repository's index, which an OCI registry doesn't
+// have, so an install must pull the chart by this reference instead.
+func ociRepoChart(name string, settings *cli.EnvSettings) (string, bool) {
+	repoName, chartName, ok := strings.Cut(name, "/")
+	if !ok {
+		return "", false
+	}
+
+	// A repositories file Helm can't read is left for Helm to report.
+	repoFile, err := repo.LoadFile(settings.RepositoryConfig)
+	if err != nil {
+		return "", false
+	}
+
+	entry := repoFile.Get(repoName)
+	if entry == nil || !registry.IsOCI(entry.URL) {
+		return "", false
+	}
+
+	// Artifact Hub lists an OCI repository by its chart's own reference, as in
+	// oci://ghcr.io/org/charts/<chart>. Any other URL is a registry namespace
+	// that holds the chart.
+	ref := strings.TrimSuffix(entry.URL, "/")
+	if path.Base(ref) != chartName {
+		ref += "/" + chartName
+	}
+
+	return ref, true
+}
