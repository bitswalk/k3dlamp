+
+func newOCITestSettings(t *testing.T) *cli.EnvSettings {
+	t.Helper()
+
+	dir := t.TempDir()
+	settings := cli.New()
+	settings.RepositoryConfig = filepath.Join(dir, "repositories.yaml")
+	settings.RepositoryCache = filepath.Join(dir, "cache")
+	settings.RegistryConfig = filepath.Join(dir, "registry", "config.json")
+
+	return settings
+}
+
+func sha256Digest(b []byte) string {
+	sum := sha256.Sum256(b)
+	return "sha256:" + hex.EncodeToString(sum[:])
+}
+
+const ocispecManifest = "application/vnd.oci.image.manifest.v1+json"
+
+type ociContent struct {
+	body      []byte
+	mediaType string
+}
+
+// ociChartContent returns what an OCI registry serves for ch, pushed as the
+// repository name at the chart's version tag, by request path.
+func ociChartContent(t *testing.T, name string, ch *chart.Chart) map[string]ociContent {
+	t.Helper()
+
+	archivePath, err := chartutil.Save(ch, t.TempDir())
+	require.NoError(t, err)
+
+	layer, err := os.ReadFile(archivePath) //nolint:gosec // the test's own temp file
+	require.NoError(t, err)
+
+	config, err := json.Marshal(ch.Metadata)
+	require.NoError(t, err)
+
+	manifest, err := json.Marshal(map[string]any{
+		"schemaVersion": 2,
+		"mediaType":     ocispecManifest,
+		"config": map[string]any{
+			"mediaType": registry.ConfigMediaType, "digest": sha256Digest(config), "size": len(config),
+		},
+		"layers": []map[string]any{{
+			"mediaType": registry.ChartLayerMediaType, "digest": sha256Digest(layer), "size": len(layer),
+		}},
+	})
+	require.NoError(t, err)
+
+	repository := "/v2/" + name
+
+	return map[string]ociContent{
+		"/v2/": {[]byte("{}"), "application/json"},
+		repository + "/manifests/" + ch.Metadata.Version:    {manifest, ocispecManifest},
+		repository + "/manifests/" + sha256Digest(manifest): {manifest, ocispecManifest},
+		repository + "/blobs/" + sha256Digest(config):       {config, "application/octet-stream"},
+		repository + "/blobs/" + sha256Digest(layer):        {layer, "application/octet-stream"},
+	}
+}
+
+// serveOCIChart serves ch from a read-only OCI registry over TLS, and counts
+// the requests it gets. The registry client trusts it because the test swaps
+// http.DefaultTransport, which the client copies, so the test must not run in
+// parallel.
+func serveOCIChart(t *testing.T, name string, ch *chart.Chart) (*httptest.Server, *atomic.Int32) {
+	t.Helper()
+
+	content := ociChartContent(t, name, ch)
+
+	var requests atomic.Int32
+
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+
+		c, ok := content[r.URL.Path]
+		if !ok {
+			http.NotFound(w, r)
+			return
+		}
+
+		w.Header().Set("Content-Type", c.mediaType)
+		w.Header().Set("Content-Length", strconv.Itoa(len(c.body)))
+		w.Header().Set("Docker-Content-Digest", sha256Digest(c.body))
+
+		if r.Method != http.MethodHead {
+			_, _ = w.Write(c.body)
+		}
+	}))
+	t.Cleanup(server.Close)
+
+	defaultTransport := http.DefaultTransport
+	http.DefaultTransport = server.Client().Transport
+
+	t.Cleanup(func() { http.DefaultTransport = defaultTransport })
+
+	return server, &requests
+}
+
+// The App Catalog adds an Artifact Hub package's repository, then installs
+// <repo>/<chart>. For an OCI repository, adding it must not look for an index,
+// and installing must pull the chart from the registry.
+func TestInstallFromOCIRepository(t *testing.T) {
+	settings := newOCITestSettings(t)
+	kubevirt := &chart.Chart{Metadata: &chart.Metadata{
+		APIVersion: chart.APIVersionV2, Name: "kubevirt", Version: "0.3.0", Type: "application",
+	}}
+
+	server, requests := serveOCIChart(t, "naval-group/kubevirt-stack-charts/kubevirt", kubevirt)
+	serverURL, err := url.Parse(server.URL)
+	require.NoError(t, err)
+
+	repoURL := "oci://" + serverURL.Host + "/naval-group/kubevirt-stack-charts/kubevirt"
+
+	require.NoError(t, addRepository(AddUpdateRepoRequest{Name: "kubevirt", URL: repoURL}, settings))
+	assert.Zero(t, requests.Load(), "adding an OCI repository contacted the registry")
+	assert.NoFileExists(t, filepath.Join(settings.RepositoryCache, helmpath.CacheIndexFile("kubevirt")))
+
+	repositories, err := listRepositories(settings)
+	require.NoError(t, err)
+	assert.Contains(t, repositories, repositoryInfo{Name: "kubevirt", URL: repoURL})
+
+	chartRef, registryClient, err := resolveChart("kubevirt/kubevirt", settings)
+	require.NoError(t, err)
+	assert.Equal(t, repoURL, chartRef)
+	require.NotNil(t, registryClient)
+
+	installClient := action.NewInstall(&action.Configuration{})
+	installClient.Version = "0.3.0"
+	installClient.SetRegistryClient(registryClient)
+
+	h := &Handler{Cache: cache.New[interface{}](), EnvSettings: settings}
+
+	pulled, err := h.getChart("install", chartRef, "kubevirt", installClient.ChartPathOptions, false, settings)
+	require.NoError(t, err)
+	assert.Equal(t, "kubevirt", pulled.Metadata.Name)
+	assert.Equal(t, "0.3.0", pulled.Metadata.Version)
+}
