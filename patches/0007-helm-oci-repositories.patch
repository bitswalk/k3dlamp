+// resolveChart returns the reference to pull for the chart a request names, and
+// the registry client to pull it with if it's in an OCI registry: an oci://
+// chart, or <repo>/<chart> in an oci:// repository. Any other chart comes back
+// as it is, without a client.
+func resolveChart(reqChart string, settings *cli.EnvSettings) (string, *registry.Client, error) {
+	ref := reqChart
+	if ociRef, ok := ociRepoChart(reqChart, settings); ok {
+		ref = ociRef
+	}
+
+	if !registry.IsOCI(ref) {
+		return ref, nil, nil
+	}
+
+	// The credentials file is where `helm registry login` saves them.
+	client, err := registry.NewClient(
+		registry.ClientOptCredentialsFile(settings.RegistryConfig),
+		registry.ClientOptEnableCache(true),
+	)
+
+	return ref, client, err
+}
