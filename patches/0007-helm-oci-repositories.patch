+func TestResolveChart(t *testing.T) {
+	settings := newOCITestSettings(t)
+	repoFile := repo.NewFile()
+	repoFile.Update(
+		&repo.Entry{Name: "kubevirt", URL: "oci://ghcr.io/naval-group/kubevirt-stack-charts/kubevirt"},
+		&repo.Entry{Name: "stack", URL: "oci://ghcr.io/naval-group/kubevirt-stack-charts/"},
+		&repo.Entry{Name: "cnpg", URL: "https://cloudnative-pg.github.io/charts"},
+	)
+	require.NoError(t, repoFile.WriteFile(settings.RepositoryConfig, defaultNewConfigFileMode))
+
+	tests := []struct {
+		chart, want string
+		client      bool
+	}{
+		// Artifact Hub's OCI repository URLs already end in the chart's name.
+		{"kubevirt/kubevirt", "oci://ghcr.io/naval-group/kubevirt-stack-charts/kubevirt", true},
+		{"stack/cdi", "oci://ghcr.io/naval-group/kubevirt-stack-charts/cdi", true},
+		{"oci://ghcr.io/org/charts/app", "oci://ghcr.io/org/charts/app", true},
+		{"cnpg/cloudnative-pg", "cnpg/cloudnative-pg", false},
+		{"missing/chart", "missing/chart", false},
+		{"/charts/local", "/charts/local", false},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.chart, func(t *testing.T) {
+			ref, client, err := resolveChart(tt.chart, settings)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, ref)
+			assert.Equal(t, tt.client, client != nil)
+		})
+	}
+}
