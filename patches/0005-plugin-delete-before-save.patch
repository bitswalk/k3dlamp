+    let finishDelete!: () => void;
+    const onDelete = vi.fn(
+      () =>
+        new Promise<void>(resolve => {
+          finishDelete = resolve;
+        })
+    );
+
+    renderPluginSettings({ plugins: createPlugins(3), onDelete });
+
+    // An unsaved change to another plugin keeps the button on screen.
+    fireEvent.click(screen.getAllByRole('checkbox')[2]);
+    const save = screen.getByRole('button', { name: 'Save & Apply' });
+    expect(save).toBeEnabled();
+
+    fireEvent.click(screen.getAllByLabelText('Delete Plugin')[0]);
+    await waitFor(() => expect(save).toBeDisabled());
+
+    await act(async () => finishDelete());
+    await waitFor(() => expect(save).toBeEnabled());
+  });
