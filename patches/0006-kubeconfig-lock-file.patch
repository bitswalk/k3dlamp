+// TestWriteToFileWaitsForLock covers a kubeconfig locked by another program,
+// such as kind or kubectl, which hold the lock by creating config.lock.
+func TestWriteToFileWaitsForLock(t *testing.T) {
+	dir := t.TempDir()
+	lockPath := filepath.Join(dir, "config.lock")
+	require.NoError(t, os.WriteFile(lockPath, nil, 0o600))
+
+	released := make(chan struct{})
+
+	go func() {
+		defer close(released)
+
+		time.Sleep(300 * time.Millisecond)
+		assert.NoError(t, os.Remove(lockPath))
+	}()
+
+	conf, err := clientcmd.Load([]byte(clusterConf))
+	require.NoError(t, err)
+
+	start := time.Now()
+
+	require.NoError(t, kubeconfig.WriteToFile(*conf, dir))
+	<-released
+	assert.GreaterOrEqual(t, time.Since(start), 300*time.Millisecond)
+
+	apiConf, err := clientcmd.LoadFromFile(filepath.Join(dir, "config"))
+	require.NoError(t, err)
+	assert.Contains(t, apiConf.Contexts, "random-cluster-4")
+	assert.NoFileExists(t, lockPath)
+}
+
+func TestLockKubeConfigFileGivesUpOnAnotherProgramsLock(t *testing.T) {
+	configPath := filepath.Join(t.TempDir(), "config")
+	lockPath := configPath + ".lock"
+	require.NoError(t, os.WriteFile(lockPath, nil, 0o600))
+
+	ctx, cancel := context.WithTimeout(context.Background(), 300*time.Millisecond)
+	defer cancel()
+
+	unlock, err := kubeconfig.LockKubeConfigFile(ctx, configPath)
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+	assert.ErrorContains(t, err, lockPath+" exists")
+	assert.Nil(t, unlock)
+	// Another program's lock is not ours to remove.
+	assert.FileExists(t, lockPath)
+}
+
+func TestLockKubeConfigFileReleasesByRemovingTheFile(t *testing.T) {
+	configPath := filepath.Join(t.TempDir(), "config")
+
+	unlock, err := kubeconfig.LockKubeConfigFile(context.Background(), configPath)
+	require.NoError(t, err)
+	assert.FileExists(t, configPath+".lock")
+
+	require.NoError(t, unlock())
+	assert.NoFileExists(t, configPath+".lock")
 }
 
