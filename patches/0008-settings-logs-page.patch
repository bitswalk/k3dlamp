+  });
+});
+
+describe('AppLogs', () => {
+  let getAppLogs: ReturnType<typeof vi.fn>;
+
+  beforeEach(() => {
+    vi.useFakeTimers();
+    getAppLogs = vi.fn();
+    window.desktopApi = { platform: 'linux', getAppLogs };
+  });
+
+  afterEach(() => {
+    vi.useRealTimers();
+    delete (window as Partial<Window>).desktopApi;
