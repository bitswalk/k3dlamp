+
+import { format } from 'node:util';
+
+/** Which process wrote a line: the Go backend, or the app's main process. */
+export type AppLogSource = 'backend' | 'app';
+
+/** One log line, as Settings → Logs receives it. */
+export interface AppLogEntry {
+  /** Increases by one per line, so the renderer can ask only for newer lines. */
+  seq: number;
+  /** When the main process received the line, as an ISO 8601 string. */
+  time: string;
+  source: AppLogSource;
+  /**
+   * The line, cut to MAX_LINE_LENGTH characters. The backend writes one JSON
+   * object per line; the main process's lines are JSON objects of the same
+   * shape, with `level` and `message`.
+   */
+  text: string;
+}
+
+/** Longest line kept. The backend's lines are far shorter. */
+export const MAX_LINE_LENGTH = 16 * 1024;
+
+// The backend writes a line for every request it serves, several a second, so
+// errors and warnings get their own buffer. Otherwise ordinary lines would
+// push an error out soon after it happened.
+const ROUTINE_CAPACITY = 5000;
+const PROBLEM_CAPACITY = 1000;
+
+// zerolog's levels, and klog's one-letter prefix (as in
+// `E1028 16:20:27.439618 30283 file.go:107] ...`) for lines from client-go.
+const PROBLEM_LEVELS = new Set(['warn', 'warning', 'error', 'fatal', 'panic']);
+const KLOG_PROBLEM = /^[WEF]\d{4} /;
+
+// The backend logs this for every request, with only a duration: no method,
+// path or status. Thousands of them would bury everything else.
+const REQUEST_COMPLETED = 'Request completed successfully';
+
+/**
+ * Sorts a line into the buffer that keeps it, or 'skip' for the backend's
+ * per-request timing lines, which aren't kept.
+ */
+export function classify(text: string): 'problem' | 'routine' | 'skip' {
+  if (text.startsWith('{')) {
+    let line: { level?: unknown; message?: unknown };
+    try {
+      line = JSON.parse(text);
+    } catch {
+      return 'routine';
+    }
+    const level = typeof line?.level === 'string' ? line.level.toLowerCase() : '';
+    if (level === 'info' && line.message === REQUEST_COMPLETED) {
+      return 'skip';
+    }
+    return PROBLEM_LEVELS.has(level) ? 'problem' : 'routine';
+  }
+  return KLOG_PROBLEM.test(text) ? 'problem' : 'routine';
+}
+
+/** A fixed-size buffer that drops its oldest entry when full. */
+class Ring {
+  private entries: AppLogEntry[] = [];
+  private start = 0;
+
+  constructor(private readonly capacity: number) {}
+
+  push(entry: AppLogEntry) {
+    if (this.entries.length < this.capacity) {
+      this.entries.push(entry);
+      return;
+    }
+    this.entries[this.start] = entry;
+    this.start = (this.start + 1) % this.capacity;
+  }
+
+  /** Entries newer than afterSeq, oldest first. */
+  since(afterSeq: number): AppLogEntry[] {
+    const ordered = this.entries.slice(this.start).concat(this.entries.slice(0, this.start));
+    return ordered.filter(entry => entry.seq > afterSeq);
+  }
+}
+
+/**
+ * Keeps the latest log lines of the app and its backend in memory, for
+ * Settings → Logs. Nothing is written to disk.
+ */
+export class AppLogBuffer {
+  private seq = 0;
+  private readonly routine = new Ring(ROUTINE_CAPACITY);
+  private readonly problems = new Ring(PROBLEM_CAPACITY);
+  // A chunk can end mid-line. The rest of the line arrives with the next chunk.
+  private readonly partial: Record<'stdout' | 'stderr', string> = { stdout: '', stderr: '' };
+
+  constructor(private readonly now: () => Date = () => new Date()) {}
+
+  /** Adds a chunk of the backend's stdout or stderr, which may hold several lines. */
+  writeBackend(stream: 'stdout' | 'stderr', chunk: Buffer | string) {
+    const lines = (this.partial[stream] + chunk.toString()).split('\n');
+    this.partial[stream] = lines.pop() ?? '';
+    if (this.partial[stream].length > MAX_LINE_LENGTH) {
+      lines.push(this.partial[stream]);
+      this.partial[stream] = '';
+    }
+    lines
+      .map(line => line.replace(/\r$/, ''))
+      .filter(line => line.trim() !== '')
+      .forEach(line => this.add('backend', line));
+  }
+
+  /** Adds a message the main process logged. */
+  writeApp(level: 'info' | 'warn' | 'error', message: string) {
+    this.add('app', JSON.stringify({ level, message }));
+  }
+
+  /** Lines newer than afterSeq, oldest first. */
+  since(afterSeq = 0): AppLogEntry[] {
+    return this.routine
+      .since(afterSeq)
+      .concat(this.problems.since(afterSeq))
+      .sort((a, b) => a.seq - b.seq);
+  }
+
+  private add(source: AppLogSource, line: string) {
+    const kind = classify(line);
+    if (kind === 'skip') {
+      return;
+    }
+    const text = line.slice(0, MAX_LINE_LENGTH);
+    const entry = { seq: ++this.seq, time: this.now().toISOString(), source, text };
+    (kind === 'problem' ? this.problems : this.routine).push(entry);
+  }
+}
+
+// main.ts echoes each chunk of backend output to the console with this prefix.
+// writeBackend has those lines already, split one per line.
+const BACKEND_ECHO = /^server process std(out|err): /;
+
+/**
+ * Copies what the main process logs with console.log, info, warn and error
+ * into the buffer, as well as to the console.
+ */
+export function captureConsole(logs: AppLogBuffer, target: Console = console) {
+  const levels = [
+    ['log', 'info'],
+    ['info', 'info'],
+    ['warn', 'warn'],
+    ['error', 'error'],
+  ] as const;
+  for (const [method, level] of levels) {
+    const original = target[method].bind(target);
+    target[method] = (...args: unknown[]) => {
+      original(...args);
+      const message = format(...args);
+      if (!BACKEND_ECHO.test(message)) {
+        logs.writeApp(level, message);
+      }
+    };
+  }
+}
