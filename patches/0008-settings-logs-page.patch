+    ]);
+  });
+
+  it('leaves out the echo of backend output, which the buffer has already', () => {
+    const target = fakeConsole();
+    const logs = new AppLogBuffer(fixedTime);
+    captureConsole(logs, target);
+
+    target.info(`server process stdout: HEADLAMP_BACKEND_READY\n`);
+    target.error(`server process stderr: ${repoError}\n`);
+
+    expect(logs.since()).toEqual([]);
+  });
+});
