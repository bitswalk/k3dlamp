+
+describe('captureConsole', () => {
+  function fakeConsole() {
+    return { log: vi.fn(), info: vi.fn(), warn: vi.fn(), error: vi.fn() } as unknown as Console;
+  }
+
+  it('copies console output into the buffer and still prints it', () => {
+    const target = fakeConsole();
+    const { info: originalInfo, error: originalError } = target;
+    const logs = new AppLogBuffer(fixedTime);
+    captureConsole(logs, target);
+
+    target.info('App starting...');
+    target.log('plugins: %d', 3);
+    target.warn('slow');
+    target.error('server process process exited with code:%s signal:%s', 1, null);
+
+    expect(originalInfo).toHaveBeenCalledWith('App starting...');
+    expect(originalError).toHaveBeenCalledOnce();
+    expect(logs.since().map(entry => [entry.source, JSON.parse(entry.text)])).toEqual([
