+import AppLogs, { AppLogEntry, formatLogLine, parseLogEntry } from './AppLogs';
+
+vi.mock('../../common/SectionBox', () => ({
+  default: ({ title, children }: { title: string; children: React.ReactNode }) => (
+    <section>
+      <h1>{title}</h1>
+      {children}
+    </section>
+  ),
+}));
+
+// The real viewer draws into an xterm canvas. This one shows the lines it gets
+// as plain text, without colours.
+vi.mock('../../common/LogViewer', () => ({
+  LogViewer: ({ logs, topActions }: { logs: string[]; topActions: React.ReactNode[] }) => (
+    <div>
+      {topActions}
+      <pre data-testid="logs">{logs.join('').replace(/\x1b\[[\d;]*m/g, '')}</pre>
+    </div>
+  ),
+}));
+
+const time = '2026-10-28T15:25:00.000Z';
+const repoError: AppLogEntry = {
+  seq: 2,
+  time,
+  source: 'backend',
+  text:
+    '{"level":"error","source":"github.com/kubernetes-sigs/headlamp/backend/pkg/helm/repository.go",' +
+    '"line":192,"error":"failed to perform \\"FetchReference\\" on source: invalid reference",' +
+    '"time":"2026-10-28T16:25:00+01:00","message":"downloading index file"}',
+};
+const dispatch: AppLogEntry = {
+  seq: 1,
+  time,
+  source: 'backend',
+  text: '{"level":"info","route":"/repositories","message":"Dispatching helm repository operation: AddRepo"}',
+};
+
+describe('parseLogEntry', () => {
+  it('reads a JSON line, with the error first among the fields', () => {
+    expect(parseLogEntry(repoError)).toEqual({
+      time: new Date(time),
+      source: 'backend',
+      severity: 'error',
+      message: 'downloading index file',
+      fields: [['error', '"failed to perform \\"FetchReference\\" on source: invalid reference"']],
+      location: 'pkg/helm/repository.go:192',
+    });
+    expect(parseLogEntry(dispatch).fields).toEqual([['route', '/repositories']]);
+  });
+
+  it('reads a klog line', () => {
+    const parsed = parseLogEntry({
+      seq: 1,
+      time,
+      source: 'backend',
+      text: 'W1028 16:20:27.439618   30283 warnings.go:107] "Warning: unrecognized format \\"int32\\""',
