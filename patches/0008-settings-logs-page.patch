+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+import Box from '@mui/material/Box';
+import Checkbox from '@mui/material/Checkbox';
+import FormControl from '@mui/material/FormControl';
+import InputLabel from '@mui/material/InputLabel';
+import ListItemText from '@mui/material/ListItemText';
+import MenuItem from '@mui/material/MenuItem';
+import Select from '@mui/material/Select';
+import Typography from '@mui/material/Typography';
+import { useEffect, useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { LogViewer } from '../../common/LogViewer';
+import { ALL_SEVERITIES, LogSeverity } from '../../common/Resource/logSeverityFilter';
+import SectionBox from '../../common/SectionBox';
+
+/** A log line the desktop app's main process kept. See app/electron/appLogs.ts. */
+export interface AppLogEntry {
+  seq: number;
+  /** When the main process received the line, as an ISO 8601 string. */
+  time: string;
+  /** The Go backend, or the app's main process. */
+  source: 'backend' | 'app';
+  /** Usually a JSON object with `level` and `message`, as the backend's logger writes. */
+  text: string;
+}
+
+/** A log line, split into the parts the page shows. */
+export interface ParsedLogLine {
+  time: Date;
+  source: AppLogEntry['source'];
+  severity: LogSeverity;
+  message: string;
+  /** The line's other fields, `error` first, as key and printable value. */
+  fields: [string, string][];
+  /** The file and line that logged it, when the line says. */
+  location?: string;
+}
+
+const POLL_INTERVAL_MS = 2000;
+// The main process keeps at most 6000 lines. This cap only matters when the
+// page stays open for a long time.
+const MAX_LINES = 10000;
+
+// klog, as client-go writes: `E1028 16:20:27.439618   30283 reflector.go:1] message`.
+const KLOG_LINE = /^([IWEF])\d{4} [\d:.]+\s+\d+ ([^\]]+)\] (.*)$/s;
+const KLOG_SEVERITY: Record<string, LogSeverity> = { I: 'info', W: 'warn', E: 'error', F: 'error' };
+// Fields the line shows in its own columns rather than as key=value pairs.
+const SHOWN_FIELDS = new Set(['level', 'time', 'message', 'source', 'line']);
+// The backend's source paths all start with this.
+const BACKEND_MODULE = /^github\.com\/kubernetes-sigs\/headlamp\/backend\//;
+
+function toSeverity(level: unknown): LogSeverity {
+  switch (typeof level === 'string' ? level.toLowerCase() : '') {
+    case 'error':
+    case 'fatal':
+    case 'panic':
+      return 'error';
+    case 'warn':
+    case 'warning':
+      return 'warn';
+    case 'debug':
+    case 'trace':
+      return 'debug';
+    default:
+      return 'info';
+  }
+}
+
+function printable(value: unknown): string {
+  if (typeof value === 'string') {
+    return /^[^\s"=]+$/.test(value) ? value : JSON.stringify(value);
+  }
+  return JSON.stringify(value);
+}
+
+/** Splits a line into its time, severity, message and fields. */
+export function parseLogEntry(entry: AppLogEntry): ParsedLogLine {
+  const parsed: ParsedLogLine = {
+    time: new Date(entry.time),
+    source: entry.source,
+    severity: 'info',
+    message: entry.text,
+    fields: [],
+  };
+
+  if (entry.text.startsWith('{')) {
+    let line: Record<string, unknown>;
+    try {
+      line = JSON.parse(entry.text);
+    } catch {
+      return parsed;
+    }
+    if (line === null || typeof line !== 'object' || Array.isArray(line)) {
+      return parsed;
+    }
+    const { level, message, source, line: lineNumber } = line;
+    parsed.severity = toSeverity(level);
+    parsed.message = typeof message === 'string' ? message : '';
+    if (typeof source === 'string') {
+      const file = source.replace(BACKEND_MODULE, '');
+      parsed.location = lineNumber === undefined ? file : `${file}:${lineNumber}`;
+    }
+    parsed.fields = Object.entries(line)
+      .filter(([key]) => !SHOWN_FIELDS.has(key))
+      .sort(([a], [b]) => Number(b === 'error') - Number(a === 'error'))
+      .map(([key, value]) => [key, printable(value)]);
+    return parsed;
+  }
+
+  const klog = KLOG_LINE.exec(entry.text);
+  if (klog) {
+    parsed.severity = KLOG_SEVERITY[klog[1]];
+    parsed.location = klog[2];
+    parsed.message = klog[3];
+  }
+  return parsed;
+}
+
+const ansi = (code: string, text: string) => `\x1b[${code}m${text}\x1b[0m`;
+const SEVERITY_STYLE: Record<LogSeverity, string> = {
+  error: '1;31',
+  warn: '1;33',
+  info: '36',
+  debug: '90',
+};
+
+function pad(n: number) {
+  return String(n).padStart(2, '0');
+}
+
+/** Formats a line for the terminal, coloured, and ending in a newline. */
+export function formatLogLine(line: ParsedLogLine): string {
+  const d = line.time;
+  const date = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
+  const time = `${date} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
+  const parts = [
+    ansi('90', time),
+    ansi(SEVERITY_STYLE[line.severity], line.severity.toUpperCase().padEnd(5)),
+    ansi('90', line.source.padEnd(7)),
+    line.message,
+    ...line.fields.map(([key, value]) =>
+      key === 'error' ? ansi('31', `${key}=${value}`) : `${key}=${value}`
+    ),
+  ];
+  if (line.location) {
+    parts.push(ansi('90', line.location));
+  }
+  return parts.filter(part => part !== '').join(' ') + '\n';
+}
+
+/**
+ * Settings → Logs: what the desktop app and its backend logged since the app
+ * started, read from the main process every two seconds while the page is open.
+ */
+export default function AppLogs() {
+  const { t } = useTranslation(['translation']);
+  const [entries, setEntries] = useState<AppLogEntry[]>([]);
+  const [severities, setSeverities] = useState<LogSeverity[]>(ALL_SEVERITIES);
+  const getAppLogs: ((afterSeq: number) => Promise<AppLogEntry[]>) | undefined =
+    window.desktopApi?.getAppLogs;
+
+  useEffect(() => {
+    if (!getAppLogs) {
+      return;
+    }
+    let active = true;
+    let lastSeq = 0;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+
+    // Each poll starts after the previous one ends, so two never ask for the
+    // same lines.
+    async function poll() {
+      try {
+        const newer = await getAppLogs!(lastSeq);
+        if (active && newer.length > 0) {
+          lastSeq = newer[newer.length - 1].seq;
+          setEntries(current => current.concat(newer).slice(-MAX_LINES));
+        }
+      } catch (err) {
+        console.error('Failed to read the app logs:', err);
+      }
+      if (active) {
+        timer = setTimeout(poll, POLL_INTERVAL_MS);
+      }
+    }
+    poll();
+
+    return () => {
+      active = false;
+      clearTimeout(timer);
+    };
+  }, [getAppLogs]);
+
+  const lines = useMemo(() => entries.map(parseLogEntry), [entries]);
+  const logs = useMemo(
+    () => lines.filter(line => severities.includes(line.severity)).map(formatLogLine),
+    [lines, severities]
+  );
+
+  const severityFilter = (
+    <FormControl key="severity" sx={{ minWidth: '9rem' }}>
+      <InputLabel shrink id="app-logs-severity-label">
+        {t('translation|Severity')}
+      </InputLabel>
+      <Select
+        labelId="app-logs-severity-label"
+        id="app-logs-severity"
+        multiple
+        size="small"
+        value={severities}
+        onChange={event => {
+          const value = event.target.value as LogSeverity[];
+          if (value.length > 0) {
+            setSeverities(value);
+          }
+        }}
+        renderValue={selected =>
+          selected.length === ALL_SEVERITIES.length
+            ? t('translation|All')
+            : (selected as LogSeverity[]).map(s => s.toUpperCase()).join(', ')
+        }
+      >
+        {ALL_SEVERITIES.map(severity => (
+          <MenuItem key={severity} value={severity}>
+            <Checkbox checked={severities.includes(severity)} size="small" />
+            <ListItemText primary={severity.toUpperCase()} />
+          </MenuItem>
+        ))}
+      </Select>
+    </FormControl>
+  );
+
+  return (
+    <SectionBox title={t('translation|Logs')} backLink>
+      <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
+        {t(
+          "translation|What the app and its backend logged since the app started. The app keeps these lines in memory only, and leaves out the backend's per-request timing lines."
+        )}
+      </Typography>
+      <Box
+        sx={{
+          height: 'calc(100vh - 17rem)',
+          minHeight: '24rem',
+          display: 'flex',
+          // The viewer is laid out for a dialog: 80% of its height, with padding.
+          '& > .MuiDialogContent-root': { height: '100%', padding: 0 },
+        }}
+      >
+        <LogViewer
+          noDialog
+          open
+          title={t('translation|Logs')}
+          downloadName="k3dlamp-logs"
+          logs={logs}
+          topActions={[severityFilter]}
+          onClose={() => {}}
+        />
+      </Box>
+    </SectionBox>
+  );
+}
