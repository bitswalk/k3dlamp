+import { describe, expect, it, vi } from 'vitest';
+import { AppLogBuffer, captureConsole, classify, MAX_LINE_LENGTH } from './appLogs';
+
+const time = '2026-10-28T16:25:00.000Z';
+const fixedTime = () => new Date(time);
+const request = '{"level":"info","duration_ms":"0.56","message":"Request completed successfully"}';
+const dispatch = '{"level":"info","message":"Dispatching helm repository operation: AddRepo"}';
+const repoError =
+  '{"level":"error","source":"github.com/kubernetes-sigs/headlamp/backend/pkg/helm/repository.go",' +
+  '"line":192,"error":"failed to perform \\"FetchReference\\" on source: invalid reference",' +
+  '"message":"downloading index file"}';
+
+describe('classify', () => {
+  it('reads the zerolog level', () => {
+    expect(classify(repoError)).toBe('problem');
+    expect(classify('{"level":"warn","message":"slow"}')).toBe('problem');
+    expect(classify(dispatch)).toBe('routine');
+  });
+
+  it('skips the per-request timing lines', () => {
+    expect(classify(request)).toBe('skip');
+    expect(classify('{"level":"error","message":"Request completed successfully"}')).toBe(
+      'problem'
+    );
+  });
+
+  it('reads the klog prefix', () => {
+    expect(classify('E1028 16:20:27.439618   30283 reflector.go:1] "failed"')).toBe('problem');
+    expect(classify('W1028 16:20:27.439618   30283 warnings.go:107] "x"')).toBe('problem');
+    expect(classify('I1028 16:20:27.439618   30283 warnings.go:107] "x"')).toBe('routine');
+  });
+
+  it('treats other lines as routine', () => {
+    expect(classify('HEADLAMP_BACKEND_READY')).toBe('routine');
+    expect(classify('{not json')).toBe('routine');
+    expect(classify('{"message":"no level"}')).toBe('routine');
+  });
+});
+
+describe('AppLogBuffer', () => {
+  it('splits backend chunks into lines and joins lines split across chunks', () => {
+    const logs = new AppLogBuffer(fixedTime);
+
+    logs.writeBackend('stderr', Buffer.from(`${dispatch}\n${request}\n{"level":"info",`));
+    logs.writeBackend('stderr', '"message":"second"}\r\n\n');
+    logs.writeBackend('stdout', 'HEADLAMP_BACKEND_READY\n');
+
+    expect(logs.since()).toEqual([
+      { seq: 1, time, source: 'backend', text: dispatch },
+      { seq: 2, time, source: 'backend', text: '{"level":"info","message":"second"}' },
+      { seq: 3, time, source: 'backend', text: 'HEADLAMP_BACKEND_READY' },
+    ]);
+  });
+
+  it('keeps the two streams apart while a line is incomplete', () => {
+    const logs = new AppLogBuffer(fixedTime);
+
+    logs.writeBackend('stdout', 'out-');
+    logs.writeBackend('stderr', 'err-');
+    logs.writeBackend('stdout', 'line\n');
+    logs.writeBackend('stderr', 'line\n');
+
+    expect(logs.since().map(entry => entry.text)).toEqual(['out-line', 'err-line']);
+  });
+
+  it('records app messages as JSON lines', () => {
+    const logs = new AppLogBuffer(fixedTime);
+    logs.writeApp('error', 'server process process exited with code:1 signal:null');
+
+    expect(logs.since()).toEqual([
+      {
+        seq: 1,
+        time,
+        source: 'app',
+        text: '{"level":"error","message":"server process process exited with code:1 signal:null"}',
+      },
+    ]);
+  });
+
+  it('returns only lines newer than the given sequence number', () => {
+    const logs = new AppLogBuffer(fixedTime);
+    logs.writeBackend('stderr', `${dispatch}\n${repoError}\n${dispatch}\n`);
+
+    expect(logs.since(1).map(entry => entry.seq)).toEqual([2, 3]);
+    expect(logs.since(3)).toEqual([]);
+  });
+
+  it('keeps errors after ordinary lines have filled the buffer many times over', () => {
+    const logs = new AppLogBuffer(fixedTime);
+    logs.writeBackend('stderr', `${repoError}\n`);
+    for (let i = 0; i < 20; i++) {
+      logs.writeBackend('stderr', `${dispatch}\n`.repeat(1000));
+    }
+
+    const entries = logs.since();
+    expect(entries).toHaveLength(5001);
+    expect(entries[0]).toMatchObject({ seq: 1, text: repoError });
+    expect(entries[1].seq).toBe(20001 - 5000 + 1);
+    expect(entries[entries.length - 1].seq).toBe(20001);
+  });
+
+  it('drops the oldest errors once a thousand newer ones arrive', () => {
+    const logs = new AppLogBuffer(fixedTime);
+    for (let i = 0; i < 1001; i++) {
+      logs.writeBackend('stderr', `{"level":"error","message":"${i}"}\n`);
+    }
+
+    const entries = logs.since();
+    expect(entries).toHaveLength(1000);
+    expect(entries[0].text).toBe('{"level":"error","message":"1"}');
+  });
+
+  it('cuts very long lines, including one that never ends', () => {
+    const logs = new AppLogBuffer(fixedTime);
+    logs.writeBackend('stderr', `${'a'.repeat(MAX_LINE_LENGTH + 10)}\n`);
+    logs.writeBackend('stdout', 'b'.repeat(MAX_LINE_LENGTH + 10));
+
+    expect(logs.since().map(entry => entry.text.length)).toEqual([
+      MAX_LINE_LENGTH,
+      MAX_LINE_LENGTH,
+    ]);
