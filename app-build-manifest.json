{
  "$schema": "https://raw.githubusercontent.com/kubernetes-sigs/headlamp/main/app/app-build-manifest.schema.json",
  "$comment": "Selected with HEADLAMP_BUILD_MANIFEST. It replaces Headlamp's default manifest, so it is the whole command policy. Grants: https://headlamp.dev/docs/latest/development/plugins/command-capabilities",
  "product": {
    "name": "k3dlamp",
    "productName": "k3dlamp",
    "companyName": "bitswalk",
    "version": "0.4.3",
    "appId": "com.github.bitswalk.k3dlamp",
    "protocols": { "name": "k3dlamp-protocol", "schemes": ["k3dlamp"] }
  },
  "proxy-urls": ["https://artifacthub.io/*"],
  "plugins": [
    {
      "name": "app-catalog",
      "packageName": "app-catalog",
      "archive": "https://github.com/headlamp-k8s/plugins/releases/download/app-catalog-0.9.1/app-catalog-0.9.1.tar.gz",
      "sha256": "e6f7869ec17d182ea6d654cd6152f89b13fb731c89640323facd794a00c640c8"
    },
    {
      "name": "plugin-catalog",
      "packageName": "@headlamp-k8s/plugin-catalog",
      "archive": "https://github.com/headlamp-k8s/plugins/releases/download/plugin-catalog-0.4.5/headlamp-k8s-plugin-catalog-0.4.5.tar.gz",
      "sha256": "4139b00b8aebe51e6a3dd77c722aeb645f63b63eff5c34e798d91d012d122749"
    }
  ],
  "commandSets": {
    "k3d": [
      { "tool": "k3d", "args": ["cluster", "list", "-o", "json"] },
      { "tool": "k3d", "args": ["cluster", "create", "--config", "-"] },
      { "tool": "k3d", "args": ["cluster", "delete"], "allowTrailingArgs": true }
    ],
    "kind": [
      { "tool": "kind", "args": ["get", "clusters"] },
      { "tool": "kind", "args": ["create", "cluster", "--config", "-", "--wait", "5m"] },
      { "tool": "kind", "args": ["delete", "cluster", "--name"], "allowTrailingArgs": true }
    ]
  },
  "runCommands": [
    {
      "environment": "production",
      "pluginLocation": "user",
      "plugins": [
        {
          "bundleName": "k3dlamp-k3d-plugin",
          "packageName": "@bitswalk/headlamp-k3d",
          "artifactHubPackage": "bitswalk-k3dlamp-k3d-plugin/k3dlamp-k3d-plugin",
          "artifactHubPackageId": "1290d265-7dd4-44d6-a16f-cfafaff20679",
          "artifactHubRepositoryId": "8b7a668e-8ca6-4128-9c0d-6bc5b1a61e8c"
        }
      ],
      "commandSets": ["k3d"]
    },
    {
      "environment": "production",
      "pluginLocation": "user",
      "plugins": [
        {
          "bundleName": "k3dlamp-kind-plugin",
          "packageName": "@bitswalk/headlamp-kind",
          "artifactHubPackage": "bitswalk-k3dlamp-kind-plugin/k3dlamp-kind-plugin",
          "artifactHubPackageId": "30504e46-fab5-4350-92b9-799f486f970e",
          "artifactHubRepositoryId": "b948282f-fac1-4431-ad0a-b4923d151716"
        }
      ],
      "commandSets": ["kind"]
    },
    {
      "environment": "development",
      "pluginLocation": "development",
      "plugins": [{ "bundleName": "headlamp-k3d", "packageName": "@bitswalk/headlamp-k3d" }],
      "commandSets": ["k3d"]
    },
    {
      "environment": "development",
      "pluginLocation": "development",
      "plugins": [{ "bundleName": "headlamp-kind", "packageName": "@bitswalk/headlamp-kind" }],
      "commandSets": ["kind"]
    }
  ],
  "legalDocuments": [
    { "id": "license", "title": "License", "file": "LICENSE" },
    { "id": "notices", "title": "Third-party notices", "file": "NOTICE" }
  ]
}
