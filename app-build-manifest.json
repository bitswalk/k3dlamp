{
  "$schema": "https://raw.githubusercontent.com/kubernetes-sigs/headlamp/main/app/app-build-manifest.schema.json",
  "$comment": "Selected with HEADLAMP_BUILD_MANIFEST. It replaces Headlamp's default manifest, so it is the whole command policy. Grants: https://headlamp.dev/docs/latest/development/plugins/command-capabilities",
  "product": {
    "name": "k3dlamp",
    "productName": "k3dlamp",
    "companyName": "bitswalk",
    "version": "0.3.1",
    "appId": "com.github.bitswalk.k3dlamp",
    "protocols": { "name": "k3dlamp-protocol", "schemes": ["k3dlamp"] }
  },
  "proxy-urls": ["https://artifacthub.io/*"],
  "plugins": [
    {
      "name": "plugin-catalog",
      "packageName": "@headlamp-k8s/plugin-catalog",
      "archive": "https://github.com/headlamp-k8s/plugins/releases/download/plugin-catalog-0.4.5/headlamp-k8s-plugin-catalog-0.4.5.tar.gz",
      "sha256": "4139b00b8aebe51e6a3dd77c722aeb645f63b63eff5c34e798d91d012d122749"
    }
  ],
  "commandSets": {
    "k3d": [
      { "tool": "k3d", "args": ["cluster", "list", "-o", "json"] },
      { "tool": "k3d", "args": ["cluster", "create", "--config"], "allowTrailingArgs": true },
      { "tool": "k3d", "args": ["cluster", "delete"], "allowTrailingArgs": true }
    ]
  },
  "runCommands": [
    {
      "environment": "production",
      "pluginLocation": "user",
      "plugins": [
        {
          "bundleName": "k3dlamp-k3d-plugin",
          "packageName": "@bitswalk/headlamp-k3d",
          "artifactHubPackage": "bitswalk/k3dlamp-k3d-plugin",
          "artifactHubPackageId": "682daae3-a51b-4b70-b7e3-8fd17aa040b6",
          "artifactHubRepositoryId": "4be0b5a4-e498-41c8-849f-dd394bbe51a6"
        }
      ],
      "commandSets": ["k3d"]
    },
    {
      "environment": "development",
      "pluginLocation": "development",
      "plugins": [{ "bundleName": "headlamp-k3d", "packageName": "@bitswalk/headlamp-k3d" }],
      "commandSets": ["k3d"]
    }
  ],
  "legalDocuments": [
    { "id": "license", "title": "License", "file": "LICENSE" },
    { "id": "notices", "title": "Third-party notices", "file": "NOTICE" }
  ]
}
